{
  "name": "pkg-guard-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Intentionally out-of-date monorepo used to record the Pkg Guard demo GIFs. Do not use in production.",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  }
}
