{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": { "@core/*": ["../../src/*"] }
  },
  "include": ["src", "../../src"],
  "exclude": ["../../src/test"]
}
